# Copy to .env for local dev. NEVER commit a real .env (CLAUDE.md §4: secrets in a vault).
# In production these come from a secrets manager, not a file.

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (EU-region in production for data residency)
DATABASE_URL=postgresql://kapar:kapar@localhost:5432/kapar_dev

# Auth — JWT access token max 15 min + rotating refresh (SPEC §11)
JWT_ACCESS_SECRET=replace_me_dev_only
JWT_REFRESH_SECRET=replace_me_dev_only
ACCESS_TOKEN_TTL=15m

# OTP — SMS provider (Viber fallback). [VERIFY channel availability + cost in NM, SPEC A0/§10]
OTP_PROVIDER_API_KEY=

# PSP — left blank on purpose. The in-memory mock is active until a real provider is verified
# (CLAUDE.md §7). Do NOT wire a real PSP key until the §7/§10 [VERIFY] items are confirmed.
PSP_API_KEY=
PSP_WEBHOOK_SECRET=
